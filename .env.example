# ──────────────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────────────
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never imported into client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────────────────────────────────────
# Patent data sources
# ──────────────────────────────────────────────────────────────────────────────
# Primary ingestion (Google BigQuery patent dataset)
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_LOCATION=US
BIGQUERY_PUBLICATIONS_TABLE=patents-public-data.patents.publications
BIGQUERY_MAX_ROWS=200
# Guardrail: fail query if BigQuery would scan more than this many bytes.
# Example: 2000000000 ~= 2GB scanned cap per query.
# BIGQUERY_MAX_BYTES_BILLED=2000000000
# Quality filter: only ingest publications on/after this YYYYMMDD date.
BIGQUERY_MIN_PUBLICATION_DATE=20100101
# Reuse recent BigQuery results for the same scout query fingerprint to avoid
# paying repeatedly for unchanged runs.
SCOUT_BIGQUERY_CACHE_HOURS=24
# Set true to bypass the DB cache and force a fresh BigQuery fetch.
# SCOUT_BIGQUERY_CACHE_BYPASS=false
# After BigQuery fetch, cap how many unique patents this run ingests (matches
# `scout_runs.patents_reviewed`). Use 3–4 with GEMINI_MATCH_LIMIT for an
# end-to-end Gemini smoke test. Leave unset for full ingest (up to BIGQUERY_MAX_ROWS).
# SCOUT_INGEST_MAX_PATENTS=4
# Path to service account JSON on local machine
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Legacy direct API placeholders (optional)
WIPO_API_BASE_URL=https://patentscope.wipo.int/search/en/
WIPO_API_KEY=your-wipo-api-key

EPO_OPS_CONSUMER_KEY=your-epo-ops-consumer-key
EPO_OPS_CONSUMER_SECRET=your-epo-ops-consumer-secret

# ──────────────────────────────────────────────────────────────────────────────
# AI providers
# ──────────────────────────────────────────────────────────────────────────────
# Gemini Flash — candidate triage
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallback models used when the primary model 404s
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
# Max pending matches Gemini classifies per run (does NOT change
# `patents_reviewed`; pair with SCOUT_INGEST_MAX_PATENTS for a small e2e test).
# Leave unset for no cap.
# GEMINI_MATCH_LIMIT=4

# Perplexity Sonar — deep research
SONAR_API_KEY=your-sonar-api-key
SONAR_MODEL=sonar-pro

# OpenAI GPT 5.5 — final report generation
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.5

# ──────────────────────────────────────────────────────────────────────────────
# Scheduled jobs
# ──────────────────────────────────────────────────────────────────────────────
# Shared secret used to authenticate Vercel Cron requests against /api/cron/*
CRON_SECRET=generate-a-long-random-string

# ──────────────────────────────────────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────────────────────────────────────
# Supabase Storage bucket where rendered PDF reports are uploaded
REPORT_BUCKET_NAME=opportunity-reports
